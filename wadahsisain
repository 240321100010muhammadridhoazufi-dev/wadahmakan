<script>
var P={300:45900,600:67900,1000:93900},S={size:600,freq:5,per:12},$=function(i){return document.getElementById(i)},cur={},fmt=function(n){return Math.round(n).toLocaleString('id-ID')};
var LV=[[0,'Pemula Hijau'],[10,'Pejuang Bekal'],[50,'Pahlawan Bumi'],[150,'Legenda Hijau'],[400,'Penjaga Bumi']];
function tween(id,to,f){var el=$(id),from=cur[id]||0,t0=performance.now();cur[id]=to;(function s(t){var p=Math.min(1,(t-t0)/700),e=1-Math.pow(1-p,3);el.textContent=f(from+(to-from)*e);if(p<1)requestAnimationFrame(s)})(t0)}
function bars(){var svg=$('bars'),w=600,h=220,base=196,per=S.freq*4.345,max=per*12||1,h2='';
for(var m=1;m<=12;m++){var v=per*m,bh=Math.max(4,v/max*150),x=14+(m-1)*48;
h2+='<rect style="--k:'+m+'" x="'+x+'" y="'+(base-bh)+'" width="34" height="'+bh+'" rx="10" fill="'+(m<=S.per?'#C6FF3D':'rgba(255,255,255,.14)')+'"><title>Bulan '+m+': '+fmt(v)+' kemasan</title></rect><text x="'+(x+17)+'" y="214" text-anchor="middle" fill="#9DBBA6" font-size="12">'+m+'</text>'}
svg.innerHTML=h2+'<text x="14" y="18" fill="#9DBBA6" font-size="13">'+fmt(per*12)+' kemasan dalam 1 tahun</text>'}
function calc(){var u=S.freq*4.345*S.per,hg=+$('hg').value||0,bt=+$('bt').value||0,g=u*bt;
tween('k1',u,fmt);tween('k2',u*hg,function(n){return 'Rp'+fmt(n)});tween('k3',u*S.size*.8/1000,function(n){return n.toLocaleString('id-ID',{maximumFractionDigits:1})});
$('u4').textContent=g>=1000?'kilogram':'gram';tween('k4',g>=1000?g/1000:g,function(n){return n.toLocaleString('id-ID',{maximumFractionDigits:g>=1000?1:0})});
var i=0;LV.forEach(function(l,k){if(u>=l[0])i=k});var nx=LV[i+1],p=nx?(u-LV[i][0])/(nx[0]-LV[i][0]):1;
$('lv').textContent=LV[i][1];$('rg').style.strokeDashoffset=339.3*(1-p);$('rp').textContent=Math.round(p*100)+'%';
$('lt').textContent=nx?'Tinggal '+fmt(nx[0]-u)+' pemakaian lagi menuju '+nx[1]+'.':'Level tertinggi. Ajak temanmu ikut bergabung!';
if(prevI!==undefined&&i>prevI)boom();prevI=i;S.u=u;S.l=LV[i][1];bars();comm()}
function seg(id,key){$(id).addEventListener('click',function(e){var b=e.target.closest('button');if(!b)return;[].forEach.call(this.children,function(x){x.setAttribute('aria-pressed','false')});b.setAttribute('aria-pressed','true');S[key]=+b.dataset.v;calc()})}
seg('size','size');seg('per','per');
$('freq').addEventListener('input',function(){S.freq=+this.value;$('fv').textContent=S.freq+'×';calc()});
$('hg').addEventListener('input',calc);$('bt').addEventListener('input',calc);
$('share').addEventListener('click',function(){boom();var tx='Dengan Sisain, aku menghindari '+fmt(S.u)+' kemasan sekali pakai dalam '+(S.per==12?'1 tahun':S.per+' bulan')+' dan naik ke level '+S.l+'. Yuk ikut bawa sisa makanan, bawa perubahan! @bysisain';
if(navigator.share){navigator.share({text:tx}).catch(function(){})}else{(navigator.clipboard?navigator.clipboard.writeText(tx):Promise.reject()).then(function(){toast('Teks disalin, tinggal tempel!')},function(){toast('Salin manual dari layar ya')})}});
function toast(m){var t=$('toast');t.textContent=m;t.classList.add('on');setTimeout(function(){t.classList.remove('on')},2200)}
var prevI,W=['bumi','makanan','uang jajan'],wi=0,MQ=['Bawa sisa makanan','Bawa perubahan','3 kompartemen','Tutup rapat berpengunci','Seal silikon','Food grade BPA-free','Scan, pahami, pakai','Reusable'];
$('mq').innerHTML=MQ.concat(MQ).map(function(x){return '<span>'+x+'</span>'}).join('');
setInterval(function(){var r=$('rw');r.classList.add('o');setTimeout(function(){wi=(wi+1)%W.length;r.textContent=W[wi];r.classList.remove('o')},350)},2400);
function boom(){for(var i=0;i<40;i++){(function(){var d=document.createElement('i');d.className='cf';d.style.background=['#C6FF3D','#F2B33D','#5CE1A0','#fff'][i%4];document.body.appendChild(d);var a=Math.random()*6.28,v=160+Math.random()*280,an=d.animate([{transform:'translate(0,0) rotate(0)',opacity:1},{transform:'translate('+Math.cos(a)*v+'px,'+(Math.sin(a)*v+280)+'px) rotate('+Math.random()*720+'deg)',opacity:0}],{duration:1400+Math.random()*700,easing:'cubic-bezier(.2,.7,.3,1)'});an.onfinish=function(){d.remove()}})()}}
function count(el){var to=+el.dataset.to,t0=performance.now();(function s(t){var p=Math.min(1,(t-t0)/1600),e=1-Math.pow(1-p,3);el.textContent=Math.round(to*e).toLocaleString('id-ID');if(p<1)requestAnimationFrame(s)})(t0)}
function go(id){var e=$(id);e.classList.add('go');setTimeout(function(){e.classList.remove('go')},2000)}
function cost(){var hg=+$('hg').value||0,pm=S.freq*4.345*hg,pr=P[S.size],mx=Math.max(pm*12,pr)*1.15||1,X=function(m){return 46+m*45},Y=function(v){return 200-v/mx*165},o='';
[0,3,6,9,12].forEach(function(m){o+='<text x="'+X(m)+'" y="224" text-anchor="middle" fill="#9DBBA6" font-size="12">'+m+' bln</text>'});
o+='<line x1="46" y1="200" x2="586" y2="200" stroke="rgba(255,255,255,.2)"/><path class="ln" pathLength="1" d="M'+X(0)+' '+Y(0)+'L'+X(12)+' '+Y(pm*12)+'" stroke="#F2B33D" stroke-width="5" fill="none" stroke-linecap="round"/><path class="ln" pathLength="1" d="M'+X(0)+' '+Y(pr)+'L'+X(12)+' '+Y(pr)+'" stroke="#C6FF3D" stroke-width="5" fill="none" stroke-linecap="round"/>';
var m=pm>0?pr/pm:99;if(m<=12)o+='<circle cx="'+X(m)+'" cy="'+Y(pr)+'" r="9" fill="#fff" stroke="#C6FF3D" stroke-width="4"/><text x="'+X(m)+'" y="'+(Y(pr)-18)+'" text-anchor="middle" fill="#fff" font-size="13" font-weight="700">Balik modal</text>';
o+='<text x="52" y="20" fill="#F2B33D" font-size="13" font-weight="700">Kemasan sekali pakai: Rp'+fmt(pm*12)+' per tahun</text><text x="52" y="40" fill="#C6FF3D" font-size="13" font-weight="700">Sisain: Rp'+fmt(pr)+' sekali beli</text>';$('cost').innerHTML=o}
function rp(n){return n>=1e6?'Rp'+(n/1e6).toLocaleString('id-ID',{maximumFractionDigits:1})+' jt':'Rp'+fmt(n)}
function comm(){var n=+$('fr').value,hg=+$('hg').value||0,u=n*S.freq*4.345*12;$('fn').textContent=fmt(n)+' orang';tween('m1',u,fmt);tween('m2',u*hg,rp);tween('m3',u*S.size*.8/1000,function(x){return fmt(x)+' L'})}
$('fr').addEventListener('input',comm);
var D=[],dk=$('days'),MS=['Mulai dari hari pertama, yuk!','Awal yang bagus, pertahankan!','Kebiasaan baik sedang terbentuk.','Hampir separuh jalan!','Kamu konsisten, lanjutkan!','Tinggal sedikit lagi!','Satu hari lagi menuju lencana!','Selamat! Kamu resmi Pejuang Bekal 7 Hari.'];
try{D=JSON.parse(localStorage.getItem('sisain7')||'[]')}catch(e){}
for(var d=1;d<=7;d++){var b=document.createElement('button');b.textContent=d;b.setAttribute('aria-label','Hari '+d);dk.appendChild(b)}
function days(){var c=0;[].forEach.call(dk.children,function(b,i){var on=D.indexOf(i)>-1;b.setAttribute('aria-pressed',on);c+=on});$('cb').style.width=c/7*100+'%';$('cm').textContent=MS[c];return c}
dk.addEventListener('click',function(e){var b=e.target.closest('button');if(!b)return;var i=+b.textContent-1,k=D.indexOf(i);k>-1?D.splice(k,1):D.push(i);try{localStorage.setItem('sisain7',JSON.stringify(D))}catch(x){}if(days()==7)boom()});
$('rst').addEventListener('click',function(){D=[];try{localStorage.removeItem('sisain7')}catch(x){}days()});days();
var io=new IntersectionObserver(function(es){es.forEach(function(e){if(!e.isIntersecting)return;var t=e.target;t.classList.add('in');io.unobserve(t);setTimeout(function(){t.style.setProperty('--i',0)},1500);t.querySelectorAll('.cu').forEach(count);if(t.querySelector('#bars')){bars();go('bars')}if(t.querySelector('#cost'))go('cost')})},{threshold:.15});
document.querySelectorAll('.t').forEach(function(t){io.observe(t)});
calc();
</script>
